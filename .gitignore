# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ⚠️ APRÈS la règle générale : en git, c'est la DERNIÈRE règle correspondante qui l'emporte,
# donc une négation placée avant `.env*` ne servirait à rien. Ce modèle SANS secret doit être
# versionné — c'est le seul repère de ce qu'il faut définir pour faire tourner le projet.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
